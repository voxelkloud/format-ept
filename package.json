{
  "name": "@voxelkloud/format-ept",
  "version": "0.5.0",
  "description": "The Entwine Point Tile driver for voxelkloud: ept.json, JSON hierarchy pages, and binary / laszip / zstandard node payloads over plain static hosting.",
  "license": "MIT",
  "keywords": [
    "point-cloud",
    "lidar",
    "ept",
    "entwine",
    "3dep",
    "laz",
    "webgpu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxelkloud/format-ept.git"
  },
  "homepage": "https://github.com/voxelkloud/voxelkloud",
  "bugs": {
    "url": "https://github.com/voxelkloud/voxelkloud/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@voxelkloud/core": "workspace:*",
    "@voxelkloud/format-las": "workspace:*",
    "@voxelkloud/wasm-codecs": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
